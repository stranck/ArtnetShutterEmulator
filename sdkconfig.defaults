# Console over the native USB-C port (USB Mode: Hardware CDC and JTAG)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Flash: 16MB, QIO 80MHz
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# PSRAM: OPI (octal), 80MHz
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# Make PSRAM available to normal malloc()
CONFIG_SPIRAM_USE_MALLOC=y

# CPU 240MHz
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# Partition table: same layout as Arduino "Huge APP (3MB No OTA/1MB SPIFFS)"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Enable the W5500 SPI Ethernet driver
CONFIG_ETH_USE_SPI_ETHERNET=y
CONFIG_ETH_SPI_ETHERNET_W5500=y

# Main task loads and applies the JSON configuration at boot
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Art-Net + sACN + web server (listen socket, control socket, browser connections)
CONFIG_LWIP_MAX_SOCKETS=16
